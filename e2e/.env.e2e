# Environment for the E2E stack (api / workers / frontend run with these vars).
# MONITOOL_AUTH_DISABLED turns on the opt-in test auth bypass (see api/src/middlewares/load-profile.js).
MONITOOL_DEBUG=TRUE
MONITOOL_PORT=8000
MONITOOL_CLUSTER=FALSE
MONITOOL_AUTH_DISABLED=TRUE

# Auth0 vars are unused when MONITOOL_AUTH_DISABLED=TRUE, but config.js still
# requires them to be present at startup, so we keep the real values here.
MONITOOL_JWKS_HOST=monitool.eu.auth0.com
MONITOOL_AUDIENCE=https://api.monitool.org
MONITOOL_ISSUER=https://monitool.eu.auth0.com/

MONITOOL_MONGO_URI=mongodb://localhost:27017
MONITOOL_MONGO_DB=monitool
MONITOOL_REDIS_URI=redis://127.0.0.1:6379/0
